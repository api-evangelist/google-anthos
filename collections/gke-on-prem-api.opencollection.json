              },
              {
                "name": "pageToken",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Lists VMware clusters in a given project and location."
        },
        {
          "info": {
            "name": "Google Anthos Create a VMware cluster",
            "type": "http"
          },
