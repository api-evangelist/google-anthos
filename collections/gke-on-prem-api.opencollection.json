            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gkeonprem.googleapis.com/v1/projects/:projectId/locations/:location/vmwareClusters",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "location",
                "value": "",
                "type": "path"
              },
              {
                "name": "pageSize",
